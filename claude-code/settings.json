{
  "permissions": {
    "allow": [
      "Bash(rm -f ~/.claude-images/*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "PowerShell(Get-InstalledModule *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-ChildItem *)",
      "WebFetch(domain:moodle.myefrei.fr)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/.claude)",
      "Bash(diskpart *)",
      "Bash(format *)",
      "PowerShell(diskpart *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(reg delete HKLM*)"
    ],
    "defaultMode": "auto"
  },
  "deniedMcpServers": [
    { "serverUrl": "https://gmailmcp.googleapis.com/*" },
    { "serverUrl": "https://calendarmcp.googleapis.com/*" },
    { "serverUrl": "https://drivemcp.googleapis.com/*" }
  ],
  "model": "opus[1m]",
  "outputStyle": "Concise",
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/.claude/hooks/curfew.ps1\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE/.claude/hooks/error-vault-trigger.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.exe",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "obsidian@ahmed-plugins-local": true,
    "content-researcher@ahmed-plugins-local": true,
    "plugin-creator@ahmed-plugins-local": true,
    "efrei@ahmed-plugins-local": true,
    "phone@ahmed-plugins-local": false,
    "senior-dev@ahmed-plugins-local": true
  },
  "language": "French",
  "effortLevel": "high",
  "askUserQuestionTimeout": "5m",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
